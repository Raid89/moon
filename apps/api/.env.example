NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:4200
MONGODB_URI=mongodb+srv://cluster-host/
MONGODB_USERNAME=moon_app
MONGODB_PASSWORD=replace-with-secret
OTP_SECRET=use-a-random-32-byte-secret
RESEND_API_KEY=re_replace-with-resend-api-key
RESEND_FROM="Moon <hola@tudominio.com>"

# Cloudflare R2: credenciales privadas, solo para la API.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# Correos autorizados del equipo Moon, separados por comas. Vacío deshabilita el panel.
ORGANIZER_EMAILS=
